create_field_setup <- function(n, rho) {
if (rho <= 0) return(list(independent = TRUE, n = n))
theta <- theta_from_rho(rho)
build_setup <- function(padding) {
n_pad <- padding * n
setup <- fields::Exp.image.cov(
grid = list(x = seq_len(n_pad), y = seq_len(n_pad)),
theta = theta,
setup = TRUE
)
list(independent = FALSE, setup = setup, n = n, n_pad = n_pad)
}
result <- tryCatch(build_setup(1L), error = function(e) NULL)
if (is.null(result)) {
result <- tryCatch(build_setup(2L), error = function(e) NULL)
}
if (is.null(result)) {
result <- tryCatch(build_setup(4L), error = function(e) NULL)
}
if (is.null(result)) {
stop("Unable to construct the exponential spatial field for rho = ", rho)
}
result
}
simulate_spatial_field <- function(field_setup) {
n <- field_setup$n
if (isTRUE(field_setup$independent)) {
return(matrix(stats::rnorm(n * n), nrow = n, ncol = n))
}
large_field <- fields::sim.rf(field_setup$setup)
start <- (field_setup$n_pad - n) %/% 2L + 1L
finish <- start + n - 1L
field <- large_field[start:finish, start:finish]
as.numeric(scale(field)) |> matrix(nrow = n, ncol = n)
}
# ------------------------------------------------------------------------------
# Elipse aleatoria: la misma geometria se usa como verdad para MK y CMK
# ------------------------------------------------------------------------------
random_ellipse <- function(n, diameter, axis_ratio) {
a <- diameter / 2
b <- a * axis_ratio
margin <- ceiling(a)
available <- seq.int(margin + 1L, n - margin)
centre_x <- sample(available, 1L)
centre_y <- sample(available, 1L)
angle <- stats::runif(1L, 0, pi)
grid <- expand.grid(row = seq_len(n), col = seq_len(n))
dx <- grid$col - centre_x
dy <- grid$row - centre_y
rotated_x <- dx * cos(angle) + dy * sin(angle)
rotated_y <- -dx * sin(angle) + dy * cos(angle)
inside <- (rotated_x / a)^2 + (rotated_y / b)^2 <= 1
index <- matrix(seq_len(n * n), nrow = n, ncol = n, byrow = TRUE)
truth <- rep(FALSE, n * n)
truth[index[cbind(grid$row[inside], grid$col[inside])]] <- TRUE
truth
}
simulate_series <- function(n, n_time, field_setup, slope = 0,
diameter = NULL, axis_ratio = 0.6) {
X <- matrix(NA_real_, nrow = n * n, ncol = n_time)
for (time in seq_len(n_time)) {
field <- simulate_spatial_field(field_setup)
X[, time] <- as.vector(t(field))
}
truth <- rep(FALSE, n * n)
if (!is.null(diameter) && slope != 0) {
truth <- random_ellipse(n, diameter, axis_ratio)
X[truth, ] <- X[truth, , drop = FALSE] +
outer(rep(slope, sum(truth)), seq_len(n_time))
}
list(series = X, truth = truth, slope = slope)
}
# ------------------------------------------------------------------------------
# MK y CMK: mismas convenciones que trend_test() de sptrends 0.95.2
#   - MK usa la correccion de continuidad clasica.
#   - CMK sigue la ecuacion publicada sin correccion de continuidad.
#   - No hay empates porque el ruido es gaussiano continuo.
# ------------------------------------------------------------------------------
mk_cmk_fast <- function(X, neighbourhood) {
n_time <- ncol(X)
n_cell <- nrow(X)
S <- numeric(n_cell)
for (i in seq_len(n_time - 1L)) {
for (j in seq.int(i + 1L, n_time)) {
S <- S + sign(X[, j] - X[, i])
}
}
var_s <- rep(
n_time * (n_time - 1) * (2 * n_time + 5) / 18,
n_cell
)
direction_mk <- (S > 0) - (S < 0)
z_mk <- (S - direction_mk) / sqrt(var_s)
z_mk[S == 0] <- 0
p_mk <- 2 * stats::pnorm(-abs(z_mk))
centred <- X - rowMeans(X)
cell_sd <- sqrt(rowSums(centred^2) / (n_time - 1))
cell_sd[cell_sd == 0] <- Inf
standardised <- centred / (sqrt(n_time) * cell_sd)
W <- neighbourhood$W
nb_count <- neighbourhood$nb_count
contextual <- which(nb_count > 0)
neighbour_s <- as.numeric(W %*% S)
neighbour_u <- as.matrix(W %*% standardised)
focal_neighbour_corr <- rowSums(standardised * neighbour_u)
neighbour_sum_sq <- rowSums(neighbour_u^2)
region_size <- rep(1, n_cell)
region_size[contextual] <- 1 + nb_count[contextual]
Sm <- S
Sm[contextual] <-
(S[contextual] + neighbour_s[contextual]) / region_size[contextual]
neighbour_neighbour_corr <- rep(0, n_cell)
neighbour_neighbour_corr[contextual] <- 0.5 * (
neighbour_sum_sq[contextual] -
nb_count[contextual] * (n_time - 1) / n_time
)
variance_sum <- var_s
variance_sum[contextual] <-
variance_sum[contextual] +
nb_count[contextual] * var_s[contextual] +
2 * var_s[contextual] * focal_neighbour_corr[contextual] +
2 * var_s[contextual] * neighbour_neighbour_corr[contextual]
var_sm <- variance_sum / region_size^2
z_cmk <- Sm / sqrt(var_sm)
p_cmk <- 2 * stats::pnorm(-abs(z_cmk))
list(
MK = list(statistic = S, variance = var_s, p = p_mk),
CMK = list(statistic = Sm, variance = var_sm, p = p_cmk)
)
}
# ------------------------------------------------------------------------------
# Validacion numerica contra el paquete instalado
# ------------------------------------------------------------------------------
validate_against_sptrends <- function(X, n, fast_result) {
if (!requireNamespace("sptrends", quietly = TRUE)) {
message("sptrends is not installed: numerical cross-check skipped.")
return(invisible(FALSE))
}
raster <- terra::rast(
nrows = n,
ncols = n,
nlyrs = ncol(X),
xmin = 0,
xmax = n,
ymin = 0,
ymax = n
)
terra::values(raster) <- X
mk <- sptrends::trend_test(
raster,
method = "MK",
ties = FALSE,
report = FALSE,
verbose = FALSE
)
cmk <- sptrends::trend_test(
raster,
method = "CMK",
ties = FALSE,
continuity = FALSE,
window_size = 3L,
report = FALSE,
verbose = FALSE
)
checks <- c(
MK_statistic = max(abs(
terra::values(mk$stats$S, mat = FALSE) - fast_result$MK$statistic
)),
MK_p = max(abs(
terra::values(mk$stats$p, mat = FALSE) - fast_result$MK$p
)),
CMK_statistic = max(abs(
terra::values(cmk$stats$Sm, mat = FALSE) - fast_result$CMK$statistic
)),
CMK_p = max(abs(
terra::values(cmk$stats$p, mat = FALSE) - fast_result$CMK$p
))
)
print(checks)
if (any(!is.finite(checks)) || any(checks > 1e-10)) {
stop("Fast MK/CMK implementation does not match sptrends.")
}
message("Numerical validation against sptrends passed.")
invisible(TRUE)
}
# ------------------------------------------------------------------------------
# Metricas por replica
# ------------------------------------------------------------------------------
evaluate_null <- function(result, alpha, rho, replicate) {
do.call(rbind, lapply(names(result), function(method) {
rejected <- result[[method]]$p <= alpha
data.frame(
scenario = "null",
rho = rho,
slope = 0,
replicate = replicate,
method = method,
type_I = mean(rejected),
type_I_background = NA_real_,
type_II = NA_real_,
type_III = NA_real_,
type_III_conditional = NA_real_
)
}))
}
evaluate_signal <- function(result, truth, slope, alpha, rho, replicate,
neighbourhood) {
expected_sign <- sign(slope)
signal_or_neighbour <- truth |
as.logical(neighbourhood$W %*% as.numeric(truth) > 0)
pure_background <- !signal_or_neighbour
do.call(rbind, lapply(names(result), function(method) {
rejected <- result[[method]]$p <= alpha
inferred_sign <- sign(result[[method]]$statistic)
detected_signal <- rejected & truth
wrong_direction <- detected_signal & inferred_sign != expected_sign
data.frame(
scenario = if (slope > 0) "positive" else "negative",
rho = rho,
slope = slope,
replicate = replicate,
method = method,
type_I = NA_real_,
# Exclude the one-cell halo around the ellipse. For CMK, a cell in
# that halo has a neighbourhood containing genuine trend cells and
# therefore is not under a purely null contextual hypothesis.
type_I_background = mean(rejected[pure_background]),
type_II = mean(!rejected[truth]),
type_III = mean(wrong_direction[truth]),
type_III_conditional = if (any(detected_signal)) {
sum(wrong_direction) / sum(detected_signal)
} else {
NA_real_
}
)
}))
}
# ------------------------------------------------------------------------------
# Resumen Monte Carlo: la replica, no la celda, es la unidad independiente
# ------------------------------------------------------------------------------
summarise_metric <- function(data, metric) {
split_key <- interaction(
data$scenario,
data$rho,
data$slope,
data$method,
drop = TRUE
)
groups <- split(data, split_key)
rows <- lapply(groups, function(group) {
values <- group[[metric]]
values <- values[is.finite(values)]
if (!length(values)) return(NULL)
estimate <- mean(values)
standard_error <- if (length(values) > 1L) {
stats::sd(values) / sqrt(length(values))
} else {
NA_real_
}
data.frame(
scenario = group$scenario[1],
rho = group$rho[1],
slope = group$slope[1],
method = group$method[1],
metric = metric,
estimate = estimate,
standard_error = standard_error,
lower_95 = max(0, estimate - 1.96 * standard_error),
upper_95 = min(1, estimate + 1.96 * standard_error),
nrep = length(values)
)
})
do.call(rbind, rows)
}
# ------------------------------------------------------------------------------
# Ejecucion
# ------------------------------------------------------------------------------
set.seed(params$seed)
neighbourhood <- prepare_cmk_neighbourhood(params$n)
# Validacion con una realizacion pequena antes del Monte Carlo.
validation_setup <- create_field_setup(12L, 0.6)
validation_data <- simulate_series(
n = 12L,
n_time = 15L,
field_setup = validation_setup,
slope = 0.05,
diameter = 6,
axis_ratio = params$axis_ratio
)
validation_neighbourhood <- prepare_cmk_neighbourhood(12L)
validation_fast <- mk_cmk_fast(
validation_data$series,
validation_neighbourhood
)
validate_against_sptrends(validation_data$series, 12L, validation_fast)
cluster <- parallel::makeCluster(params$n_cores, type = "PSOCK")
all_results <- tryCatch({
parallel::clusterEvalQ(cluster, {
library(fields)
library(Matrix)
NULL
})
parallel::clusterExport(
cluster,
varlist = c(
"params",
"simulate_spatial_field",
"random_ellipse",
"simulate_series",
"mk_cmk_fast",
"evaluate_null",
"evaluate_signal",
"neighbourhood"
),
envir = environment()
)
result_list <- list()
result_index <- 0L
for (rho in params$rho) {
message(sprintf("rho = %.1f", rho))
field_setup <- create_field_setup(params$n, rho)
parallel::clusterExport(
cluster,
varlist = c("rho", "field_setup"),
envir = environment()
)
null_results <- pbapply::pblapply(
seq_len(params$nrep),
cl = cluster,
FUN = function(replicate) {
set.seed(params$seed + replicate + round(rho * 10000))
simulation <- simulate_series(
params$n,
params$n_time,
field_setup,
slope = 0
)
tests <- mk_cmk_fast(simulation$series, neighbourhood)
evaluate_null(tests, params$alpha, rho, replicate)
}
)
result_index <- result_index + 1L
result_list[[result_index]] <- do.call(rbind, null_results)
for (slope in params$slopes) {
parallel::clusterExport(
cluster,
varlist = "slope",
envir = environment()
)
signal_results <- pbapply::pblapply(
seq_len(params$nrep),
cl = cluster,
FUN = function(replicate) {
seed_offset <- if (slope > 0) 100000L else 200000L
set.seed(
params$seed + seed_offset + replicate + round(rho * 10000)
)
simulation <- simulate_series(
params$n,
params$n_time,
field_setup,
slope = slope,
diameter = params$ellipse_diameter,
axis_ratio = params$axis_ratio
)
tests <- mk_cmk_fast(simulation$series, neighbourhood)
evaluate_signal(
tests,
simulation$truth,
slope,
params$alpha,
rho,
replicate,
neighbourhood
)
}
)
result_index <- result_index + 1L
result_list[[result_index]] <- do.call(rbind, signal_results)
}
}
result_list
}, finally = {
parallel::stopCluster(cluster)
})
replicate_results <- do.call(rbind, all_results)
metrics <- c(
"type_I",
"type_I_background",
"type_II",
"type_III",
"type_III_conditional"
)
summary_results <- do.call(
rbind,
lapply(metrics, function(metric) {
summarise_metric(replicate_results, metric)
})
)
utils::write.csv(
replicate_results,
file.path(params$output_dir, "mk_cmk_resultados_replicas.csv"),
row.names = FALSE
)
utils::write.csv(
summary_results,
file.path(params$output_dir, "mk_cmk_resumen_errores.csv"),
row.names = FALSE
)
saveRDS(
list(
parameters = params,
replicates = replicate_results,
summary = summary_results
),
file.path(params$output_dir, "mk_cmk_experimento_completo.rds")
)
# ------------------------------------------------------------------------------
# Graficos
# ------------------------------------------------------------------------------
plot_data <- summary_results
plot_data$method <- factor(plot_data$method, levels = c("MK", "CMK"))
colours <- c(MK = "#0072B2", CMK = "#D55E00")
plot_metric <- function(metric, title, y_label, filename) {
data <- plot_data[plot_data$metric == metric, , drop = FALSE]
graph <- ggplot2::ggplot(
data,
ggplot2::aes(
x = rho,
y = estimate,
colour = method,
shape = method,
group = method
)
) +
ggplot2::geom_line(linewidth = 0.6) +
ggplot2::geom_point(size = 2.5) +
ggplot2::geom_errorbar(
ggplot2::aes(ymin = lower_95, ymax = upper_95),
width = 0.02
) +
ggplot2::facet_wrap(~scenario) +
ggplot2::scale_colour_manual(values = colours) +
ggplot2::coord_cartesian(ylim = c(0, 1)) +
ggplot2::labs(
title = title,
x = "Spatial correlation at distance one",
y = y_label,
colour = "Test",
shape = "Test"
) +
ggplot2::theme_minimal(base_size = 11)
ggplot2::ggsave(
file.path(params$output_dir, filename),
graph,
width = 8,
height = 4.8,
dpi = 300
)
graph
}
print(plot_metric(
"type_I",
"Type I error under the complete null field",
"Type I error rate",
"01_error_tipo_I.png"
))
print(plot_metric(
"type_I_background",
"Type I error outside the true trend region",
"Background Type I error rate",
"02_error_tipo_I_fuera_senal.png"
))
print(plot_metric(
"type_II",
"Type II error within the true trend region",
"Type II error rate",
"03_error_tipo_II.png"
))
print(plot_metric(
"type_III",
"Type III error within the true trend region",
"Type III error rate",
"04_error_tipo_III.png"
))
print(plot_metric(
"type_III_conditional",
"Wrong direction among significant detections",
"Conditional Type III error rate",
"05_error_tipo_III_condicional.png"
))
print(summary_results)
message("Results written to: ", normalizePath(params$output_dir))
