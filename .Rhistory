# ============================================================
# Contraste de sptrends::trend_test(method="CMK") contra
# ConMK::contextual_mann_kendall() -- la implementacion externa
# de referencia que la documentacion de sptrends cita para el
# modo de compatibilidad con continuity=TRUE.
# ============================================================
#
# ConMK usa el paquete "raster" (RasterStack), no "terra" -- hay
# que convertir entre formatos. Si no lo tienes instalado:
#   install.packages(c("raster", "devtools"))
#   devtools::install_github("antiphon/ConMK", build_vignettes = FALSE)
library(sptrends)
library(raster)
suppressMessages(library(ConMK))
set.seed(1)
# ------------------------------------------------------------
# PARTE 1: Comparacion general -- misma serie simulada, ambos
# metodos, cuanto coinciden estadistico y p-valor
# ------------------------------------------------------------
sim <- sim_trend_stack(nrow = 10, ncol = 10, n_time = 15,
trend_fraction = 0.5, trend_strength = 0.2,
noise_sd = 0.3, seed = 1, verbose = FALSE)
# sptrends (terra) -> raster, para dárselo a ConMK
ruta_temporal <- tempfile(fileext = ".tif")
terra::writeRaster(sim$series, ruta_temporal, overwrite = TRUE)
stack_raster <- raster::stack(ruta_temporal)
resultado_sptrends <- trend_test(sim$series, method = "CMK",
report = FALSE, verbose = FALSE)
# Ajusta el nombre de la funcion/argumentos si tu version de ConMK
# difiere -- revisa ?ConMK::contextual_mann_kendall si esto falla.
resultado_conmk <- contextual_mann_kendall(stack_raster)
cat("=== PARTE 1: Comparacion general (sin continuidad) ===\n")
cat("Clase del resultado de ConMK:\n")
print(class(resultado_conmk))
cat("\nNombres de las capas que devuelve ConMK:\n")
print(names(resultado_conmk))
# Ajusta estos nombres de capa segun lo que la linea anterior muestre
# -- ConMK puede llamarlas distinto (p.ej. "S", "p.value", "tau"...)
Sm_sptrends <- terra::values(resultado_sptrends$stats$Sm, mat = FALSE)
p_sptrends <- terra::values(resultado_sptrends$stats$p, mat = FALSE)
cat("\nPrimeros valores de Sm en sptrends:\n")
print(head(Sm_sptrends, 10))
cat("\nInspecciona 'resultado_conmk' con str()/names() para localizar\n")
cat("las capas equivalentes de estadistico y p-valor antes de continuar\n")
cat("con la comparacion numerica de abajo.\n\n")
# Una vez identificados los nombres correctos, descomenta y ajusta:
# Sm_conmk <- raster::values(resultado_conmk[["NOMBRE_S_AQUI"]])
# p_conmk <- raster::values(resultado_conmk[["NOMBRE_P_AQUI"]])
# cat("Correlacion Sm sptrends vs ConMK:",
#     cor(Sm_sptrends, Sm_conmk, use = "complete.obs"), "\n")
# cat("Diferencia absoluta maxima en Sm:",
#     max(abs(Sm_sptrends - Sm_conmk), na.rm = TRUE), "\n")
# cat("Correlacion p-valor sptrends vs ConMK:",
#     cor(p_sptrends, p_conmk, use = "complete.obs"), "\n")
# ------------------------------------------------------------
# PARTE 2: EL CASO ESPECIFICO QUE DEJAMOS SIN RESOLVER --
# continuity=TRUE con Sm==0. sptrends usa D=(Sm>0)*1 (posible Z
# espurio no-cero cuando Sm==0 exacto). Buscamos si ConMK tiene
# el mismo comportamiento o no.
# ------------------------------------------------------------
cat("\n\n=== PARTE 2: El caso Sm==0 con continuidad ===\n")
# Serie null pura, disenada para maximizar la probabilidad de que
# alguna celda de contexto de Sm==0 exacto
sim_nulo <- sim_trend_stack(nrow = 15, ncol = 15, n_time = 10,
trend_fraction = 0, noise_sd = 1,
seed = 2, verbose = FALSE)
resultado_continuidad <- trend_test(sim_nulo$series, method = "CMK",
continuity = TRUE, report = FALSE,
verbose = FALSE)
Sm_nulo <- terra::values(resultado_continuidad$stats$Sm, mat = FALSE)
p_nulo <- terra::values(resultado_continuidad$stats$p, mat = FALSE)
celdas_Sm_cero <- which(Sm_nulo == 0)
cat(sprintf("Celdas con Sm exactamente 0: %d de %d\n",
length(celdas_Sm_cero), length(Sm_nulo)))
if (length(celdas_Sm_cero) > 0) {
cat("p-valor de sptrends en esas celdas (Sm==0, continuity=TRUE):\n")
print(summary(p_nulo[celdas_Sm_cero]))
cat("\nSi el bug sospechado esta presente, estos p-valores seran\n")
cat("sistematicamente MENORES que 1 (deberian ser exactamente 1,\n")
cat("dado que Sm==0 significa ausencia total de evidencia).\n")
cat("\nAhora compara manualmente contra ConMK en las MISMAS celdas,\n")
cat("una vez identifiques como extraer su estadistico/p-valor en la\n")
cat("Parte 1 -- si ConMK TAMBIEN da p < 1 en estas celdas, confirma\n")
cat("que sptrends replica fielmente el comportamiento de ConMK (y\n")
cat("por tanto no se debe 'corregir' sin romper esa compatibilidad).\n")
cat("Si ConMK da p == 1 en estas celdas, confirma que es un bug real\n")
cat("de sptrends que si conviene corregir.\n")
} else {
cat("Ninguna celda con Sm==0 exacto en esta simulacion -- prueba con\n")
cat("una rejilla mayor o mas replicas para encontrar el caso.\n")
}
# ============================================================
# Continuacion: nombres de capa de ConMK ya confirmados (S, s2, p)
# ============================================================
# --- Parte 1 completa: comparacion general ---
Sm_conmk <- raster::values(resultado_conmk[["S"]])
p_conmk <- raster::values(resultado_conmk[["p"]])
cat("=== Parte 1 completa: sptrends vs ConMK (sin continuidad) ===\n")
cat("Correlacion S:", cor(Sm_sptrends, Sm_conmk, use = "complete.obs"), "\n")
cat("Diferencia absoluta maxima en S:",
max(abs(Sm_sptrends - Sm_conmk), na.rm = TRUE), "\n")
cat("Correlacion p-valor:", cor(p_sptrends, p_conmk, use = "complete.obs"), "\n")
cat("Diferencia absoluta maxima en p:",
max(abs(p_sptrends - p_conmk), na.rm = TRUE), "\n")
# --- La comparacion que de verdad importa: el caso Sm==0 ---
# Repetimos la simulacion nula con continuity=TRUE en ConMK tambien,
# usando LA MISMA rejilla para que las celdas sean comparables.
ruta_nulo <- tempfile(fileext = ".tif")
terra::writeRaster(sim_nulo$series, ruta_nulo, overwrite = TRUE)
stack_nulo <- raster::stack(ruta_nulo)
# Revisa con args(contextual_mann_kendall) si el nombre del argumento
# de continuidad no es exactamente "continuity" -- ajusta si hace falta.
resultado_conmk_continuidad <- contextual_mann_kendall(
stack_nulo, continuity = TRUE
)
S_conmk_nulo <- raster::values(resultado_conmk_continuidad[["S"]])
p_conmk_nulo <- raster::values(resultado_conmk_continuidad[["p"]])
cat("\n\n=== LA COMPARACION CLAVE: p-valor en las celdas con Sm==0 ===\n")
cat("sptrends, en esas", length(celdas_Sm_cero), "celdas:\n")
print(p_nulo[celdas_Sm_cero])
cat("\nConMK, en las MISMAS celdas (mismo indice de celda):\n")
print(p_conmk_nulo[celdas_Sm_cero])
cat("\nS de ConMK en esas celdas (deberia ser tambien 0, confirmando\n")
cat("que son las mismas celdas nulas en ambos):\n")
print(S_conmk_nulo[celdas_Sm_cero])
cat("\n=== Conclusion ===\n")
if (all(abs(p_conmk_nulo[celdas_Sm_cero] - 1) < 0.01)) {
cat("ConMK da p=1 en estas celdas -- CONFIRMADO: es un bug real de\n")
cat("sptrends, no una replica deliberada de ConMK. Conviene corregirlo.\n")
} else if (all(abs(p_conmk_nulo[celdas_Sm_cero] - p_nulo[celdas_Sm_cero]) < 0.01)) {
cat("ConMK coincide con sptrends (p < 1 tambien) -- CONFIRMADO:\n")
cat("sptrends replica fielmente el comportamiento de ConMK. No tocar.\n")
} else {
cat("Los valores no coinciden claramente con ninguna de las dos\n")
cat("hipotesis -- pega este resultado para revisarlo con mas cuidado.\n")
}
if ("sptrends" %in% rownames(installed.packages())) remove.packages("sptrends")
setwd("C:/Users/olive/OneDrive/Documentos/sptrends")
devtools::document()
devtools::install(build_vignettes = TRUE)
devtools::check()
cov <- covr::package_coverage()
cov
results <- benchmark_methods(
scenarios = scenarios,
methods = methods,
n_replicates = 10,
stage = "trend_test",
metrics = c(
"type_i",
"type_ii",
"field_power",
"global_power",
"within_image_power",
"fdr"
),
seed = 20260809,
verbose = TRUE
)
# ============================================================
# SIMULACIÓN MK FRENTE A CMK
# Señal coherente frente a señal espacialmente aislada
# 10 réplicas exploratorias
# ============================================================
library(sptrends)
stopifnot(packageVersion("sptrends") >= "1.4.2")
# ------------------------------------------------------------
# 1. Dimensiones y máscaras de señal
# ------------------------------------------------------------
nr <- 30
nc <- 30
# Señal coherente: bloque central de 6 × 6 = 36 celdas
mask_coherent <- matrix(FALSE, nrow = nr, ncol = nc)
mask_coherent[13:18, 13:18] <- TRUE
# Señal dispersa: 36 celdas separadas espacialmente
positions <- c(4, 8, 12, 16, 20, 24)
mask_isolated <- outer(
seq_len(nr) %in% positions,
seq_len(nc) %in% positions,
FUN = "&"
)
stopifnot(
sum(mask_coherent) == 36,
sum(mask_isolated) == 36
)
# Visualización de las dos verdades espaciales
op <- par(mfrow = c(1, 2))
image(
t(mask_coherent[nr:1, ]),
col = c("grey90", "#0072B2"),
axes = FALSE,
main = "Coherent signal: 36 cells"
)
image(
t(mask_isolated[nr:1, ]),
col = c("grey90", "#D55E00"),
axes = FALSE,
main = "Isolated signal: 36 cells"
)
par(op)
# ------------------------------------------------------------
# 2. Parámetros comunes
# ------------------------------------------------------------
common <- list(
nrow = nr,
ncol = nc,
n_time = 25,
trend_strength = 0.04,
trend_fraction = 1,
ar1 = 0,
noise_sd = 1,
noise_dist = "gaussian",
constant_block = FALSE
)
# ------------------------------------------------------------
# 3. Escenarios
# ------------------------------------------------------------
scenarios <- list(
# Hipótesis nula
null_independent = utils::modifyList(
common,
list(
trend_fraction = 0,
spatial_model = "independent"
)
),
null_rho03 = utils::modifyList(
common,
list(
trend_fraction = 0,
spatial_model = "gaussian",
spatial_rho = 0.3
)
),
null_rho07 = utils::modifyList(
common,
list(
trend_fraction = 0,
spatial_model = "gaussian",
spatial_rho = 0.7
)
),
# Señales coherentes
coherent_independent = utils::modifyList(
common,
list(
trend_shape = "custom",
custom_mask = mask_coherent,
spatial_model = "independent"
)
),
coherent_rho03 = utils::modifyList(
common,
list(
trend_shape = "custom",
custom_mask = mask_coherent,
spatial_model = "gaussian",
spatial_rho = 0.3
)
),
coherent_rho07 = utils::modifyList(
common,
list(
trend_shape = "custom",
custom_mask = mask_coherent,
spatial_model = "gaussian",
spatial_rho = 0.7
)
),
# Señales aisladas
isolated_independent = utils::modifyList(
common,
list(
trend_shape = "custom",
custom_mask = mask_isolated,
spatial_model = "independent"
)
),
isolated_rho03 = utils::modifyList(
common,
list(
trend_shape = "custom",
custom_mask = mask_isolated,
spatial_model = "gaussian",
spatial_rho = 0.3
)
),
isolated_rho07 = utils::modifyList(
common,
list(
trend_shape = "custom",
custom_mask = mask_isolated,
spatial_model = "gaussian",
spatial_rho = 0.7
)
)
)
# ------------------------------------------------------------
# 4. Métodos
# ------------------------------------------------------------
methods <- list(
MK = function(series, simulation) {
result <- trend_test(
series,
method = "MK",
report = FALSE,
verbose = FALSE
)
list(
significant = result$stats$p <= 0.05,
direction = result$stats$S
)
},
CMK = function(series, simulation) {
result <- trend_test(
series,
method = "CMK",
window_size = 3,
continuity = FALSE,
report = FALSE,
verbose = FALSE
)
list(
significant = result$stats$p <= 0.05,
direction = result$stats$Sm
)
}
)
# ------------------------------------------------------------
# 5. Benchmark pareado: solo 10 réplicas
# ------------------------------------------------------------
results <- benchmark_methods(
scenarios = scenarios,
methods = methods,
n_replicates = 10,
stage = "trend_test",
metrics = c(
"type_i",
"type_ii",
"type_iii",
"field_power",
"global_power",
"within_image_power",
"directional_power",
"fdr"
),
seed = 20260809,
verbose = TRUE
)
# ------------------------------------------------------------
# 6. Resumen
# ------------------------------------------------------------
summary_results <- benchmark_summary(
results,
verbose = FALSE
)
selected <- summary_results[, c(
"Scenario",
"Method",
"n_replicates",
"TypeI_mean",
"TypeII_mean",
"TypeIII_mean",
"GlobalPower_mean",
"WithinImagePower_mean",
"DirectionalPower_mean",
"FDR_mean"
)]
print(selected, row.names = FALSE)
# ------------------------------------------------------------
# 7. Diferencia de potencia entre CMK y MK
# ------------------------------------------------------------
mk <- summary_results[
summary_results$Method == "MK",
c(
"Scenario",
"TypeI_mean",
"GlobalPower_mean",
"WithinImagePower_mean"
)
]
cmk <- summary_results[
summary_results$Method == "CMK",
c(
"Scenario",
"TypeI_mean",
"GlobalPower_mean",
"WithinImagePower_mean"
)
]
comparison <- merge(
mk,
cmk,
by = "Scenario",
suffixes = c("_MK", "_CMK")
)
comparison$CMK_minus_MK_power <-
comparison$WithinImagePower_mean_CMK -
comparison$WithinImagePower_mean_MK
comparison$CMK_minus_MK_global <-
comparison$GlobalPower_mean_CMK -
comparison$GlobalPower_mean_MK
comparison$CMK_minus_MK_typeI <-
comparison$TypeI_mean_CMK -
comparison$TypeI_mean_MK
print(
comparison[, c(
"Scenario",
"WithinImagePower_mean_MK",
"WithinImagePower_mean_CMK",
"CMK_minus_MK_power",
"GlobalPower_mean_MK",
"GlobalPower_mean_CMK",
"CMK_minus_MK_typeI"
)],
row.names = FALSE
)
# ------------------------------------------------------------
# 8. Gráfico exploratorio
# ------------------------------------------------------------
signal_results <- subset(
summary_results,
grepl("coherent|isolated", Scenario)
)
signal_results$Signal <- ifelse(
grepl("coherent", signal_results$Scenario),
"Coherent",
"Isolated"
)
signal_results$Rho <- ifelse(
grepl("rho07", signal_results$Scenario),
0.7,
ifelse(
grepl("rho03", signal_results$Scenario),
0.3,
0
)
)
colours <- c(MK = "#D55E00", CMK = "#0072B2")
symbols <- c(MK = 16, CMK = 17)
op <- par(mfrow = c(1, 2), mar = c(5, 4, 3, 1))
for (signal_type in c("Coherent", "Isolated")) {
z <- signal_results[
signal_results$Signal == signal_type,
]
plot(
NA,
xlim = c(0, 0.7),
ylim = c(0, 1),
xlab = expression("Spatial dependence (" * rho * ")"),
ylab = "Within-image power",
main = paste(signal_type, "signal")
)
for (method_name in c("MK", "CMK")) {
zz <- z[z$Method == method_name, ]
zz <- zz[order(zz$Rho), ]
lines(
zz$Rho,
zz$WithinImagePower_mean,
type = "b",
lwd = 2,
pch = symbols[method_name],
col = colours[method_name]
)
}
legend(
"bottomleft",
legend = c("MK", "CMK"),
col = colours,
pch = symbols,
lwd = 2,
bty = "n"
)
}
par(op)
