cd "C:\Users\olive\OneDrive\Documentos\sptrends"
remove.packages("sptrends")
remove.packages("sptrends")
remove.packages("sptrends")
remove.packages("sptrends")
if ("sptrends" %in% rownames(installed.packages())) remove.packages("sptrends")
setwd("C:/Users/olive/OneDrive/Documentos/sptrends")
devtools::document()
devtools::install(build_vignettes = TRUE)
# REINICIA R AQUI antes de continuar (Session > Restart R) --
# si no reinicias, a veces queda una instalacion "fantasma" que
# corrompe la documentacion (nos paso varias veces con CRAN)
setwd("C:/Users/olive/OneDrive/Documentos/sptrends")
devtools::test()
# --as-cran replica el check real de CRAN (incluye --run-donttest,
# que sin esto no se ejecuta) -- usar SIEMPRE esta forma, no
# devtools::check() a secas
devtools::check(args = "--as-cran", build_args = "--compact-vignettes=gs+qpdf")
# IMPORTANTE, PARA NO OLVIDAR:
# Desde la version 1.5.6, hay 19 tests que arrancan un cluster
# paralelo real (n_cores > 1) y estan marcados para SALTARSE por
# defecto (.skip_unless_parallel_tests()). Esto fue una correccion
# real pedida por CRAN: esos 19 tests por si solos sumaban mas de la
# mitad del tiempo total de comprobacion del paquete, e hicieron que
# CRAN rechazara un envio por tardar mas de 10 minutos en total.
#
# Por eso, SIN la siguiente linea, covr::package_coverage() JAMAS
# llegara a 100% -- no es un fallo, es el precio aceptado a cambio
# de que CRAN acepte el paquete. Para ver la cobertura REAL (con esos
# 19 tests incluidos), hay que activar la variable de entorno ANTES:
Sys.setenv(SPTRENDS_TEST_PARALLEL = "true")
cov <- covr::package_coverage()
print(cov)
